SettingsUnitsInfo Soreno_Ivory_2x2_units { meters_scale=0.01; }
UVWGenChannel Soreno_Ivory_2x2_uvw { uvw_channel=1; }
BitmapBuffer Soreno_Ivory_2x2_Color_buffer { file="textures/Color.png"; transfer_function=2; gamma=1; }
TexBitmap Soreno_Ivory_2x2_Color { bitmap=Soreno_Ivory_2x2_Color_buffer; uvwgen=Soreno_Ivory_2x2_uvw; tile=1; }
BitmapBuffer Soreno_Ivory_2x2_Normal_buffer { file="textures/Normal.png"; transfer_function=0; gamma=1; }
TexBitmap Soreno_Ivory_2x2_Normal { bitmap=Soreno_Ivory_2x2_Normal_buffer; uvwgen=Soreno_Ivory_2x2_uvw; tile=1; }
BitmapBuffer Soreno_Ivory_2x2_Roughness_buffer { file="textures/Roughness.png"; transfer_function=0; gamma=1; }
TexBitmap Soreno_Ivory_2x2_Roughness { bitmap=Soreno_Ivory_2x2_Roughness_buffer; uvwgen=Soreno_Ivory_2x2_uvw; tile=1; }
BRDFVRayMtl Soreno_Ivory_2x2_brdf { diffuse=Soreno_Ivory_2x2_Color; reflect=Color(1,1,1); fresnel=1; fresnel_ior=1.5; refract_ior=1.5; metalness=0; option_use_roughness=1; reflect_glossiness=Soreno_Ivory_2x2_Roughness; bump_map=Soreno_Ivory_2x2_Normal; bump_type=1; bump_amount=1; }
MtlSingleBRDF Soreno_Ivory_2x2 { brdf=Soreno_Ivory_2x2_brdf; }
