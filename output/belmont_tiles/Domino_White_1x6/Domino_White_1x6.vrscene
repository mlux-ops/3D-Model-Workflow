SettingsUnitsInfo Domino_White_1x6_units { meters_scale=0.01; }
UVWGenChannel Domino_White_1x6_uvw { uvw_channel=1; }
BitmapBuffer Domino_White_1x6_Color_buffer { file="textures/Color.png"; transfer_function=2; gamma=1; }
TexBitmap Domino_White_1x6_Color { bitmap=Domino_White_1x6_Color_buffer; uvwgen=Domino_White_1x6_uvw; tile=1; }
BitmapBuffer Domino_White_1x6_Normal_buffer { file="textures/Normal.png"; transfer_function=0; gamma=1; }
TexBitmap Domino_White_1x6_Normal { bitmap=Domino_White_1x6_Normal_buffer; uvwgen=Domino_White_1x6_uvw; tile=1; }
BitmapBuffer Domino_White_1x6_Roughness_buffer { file="textures/Roughness.png"; transfer_function=0; gamma=1; }
TexBitmap Domino_White_1x6_Roughness { bitmap=Domino_White_1x6_Roughness_buffer; uvwgen=Domino_White_1x6_uvw; tile=1; }
BRDFVRayMtl Domino_White_1x6_brdf { diffuse=Domino_White_1x6_Color; reflect=Color(1,1,1); fresnel=1; fresnel_ior=1.5; refract_ior=1.5; metalness=0; option_use_roughness=1; reflect_glossiness=Domino_White_1x6_Roughness; bump_map=Domino_White_1x6_Normal; bump_type=1; bump_amount=1; }
MtlSingleBRDF Domino_White_1x6 { brdf=Domino_White_1x6_brdf; }
