  <Asset renderer="vray" url="/Domino_White_1x6/BRDF" type="BRDF" layout="">
    <plugin>
      <vrayplugin name="BRDFVRayMtl" type="BRDF" version="0">
        <parameters>
          <parameter handler="default" label="diffuse" name="diffuse" listType="none" type="acolor texture">
            <value>/Domino_White_1x6/Color</value>
          </parameter>
          <parameter handler="default" label="reflect" name="reflect" listType="none" type="color">
            <value>
              <r>1</r>
              <g>1</g>
              <b>1</b>
            </value>
          </parameter>
          <parameter handler="default" label="fresnel" name="fresnel" listType="none" type="bool">
            <value>1</value>
          </parameter>
          <parameter handler="default" label="fresnel_ior" name="fresnel_ior" listType="none" type="float texture">
            <value>1.5</value>
          </parameter>
          <parameter handler="default" label="refract_ior" name="refract_ior" listType="none" type="float texture">
            <value>1.5</value>
          </parameter>
          <parameter handler="default" label="metalness" name="metalness" listType="none" type="float texture">
            <value>0</value>
          </parameter>
          <parameter handler="default" label="option_use_roughness" name="option_use_roughness" listType="none" type="bool">
            <value>1</value>
          </parameter>
          <parameter handler="default" label="reflect_glossiness" name="reflect_glossiness" listType="none" type="float texture">
            <value>/Domino_White_1x6/Roughness</value>
          </parameter>
          <parameter handler="default" label="bump_map" name="bump_map" listType="none" type="acolor texture">
