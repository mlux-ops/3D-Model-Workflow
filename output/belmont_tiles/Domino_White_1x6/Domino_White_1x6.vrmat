          </parameter>
          <parameter handler="default" label="bump_type" name="bump_type" listType="none" type="integer">
            <value>1</value>
          </parameter>
          <parameter handler="default" label="bump_amount" name="bump_amount" listType="none" type="float texture">
            <value>1</value>
          </parameter>
        </parameters>
      </vrayplugin>
    </plugin>
  </Asset>
