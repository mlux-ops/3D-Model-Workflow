SettingsUnitsInfo Clara_Bermuda_4x4_units { meters_scale=0.01; }
UVWGenChannel Clara_Bermuda_4x4_uvw { uvw_channel=1; }
BitmapBuffer Clara_Bermuda_4x4_Color_buffer { file="textures/Color.png"; transfer_function=2; gamma=1; }
TexBitmap Clara_Bermuda_4x4_Color { bitmap=Clara_Bermuda_4x4_Color_buffer; uvwgen=Clara_Bermuda_4x4_uvw; tile=1; }
BitmapBuffer Clara_Bermuda_4x4_Normal_buffer { file="textures/Normal.png"; transfer_function=0; gamma=1; }
TexBitmap Clara_Bermuda_4x4_Normal { bitmap=Clara_Bermuda_4x4_Normal_buffer; uvwgen=Clara_Bermuda_4x4_uvw; tile=1; }
BitmapBuffer Clara_Bermuda_4x4_Roughness_buffer { file="textures/Roughness.png"; transfer_function=0; gamma=1; }
TexBitmap Clara_Bermuda_4x4_Roughness { bitmap=Clara_Bermuda_4x4_Roughness_buffer; uvwgen=Clara_Bermuda_4x4_uvw; tile=1; }
BRDFVRayMtl Clara_Bermuda_4x4_brdf { diffuse=Clara_Bermuda_4x4_Color; reflect=Color(1,1,1); fresnel=1; fresnel_ior=1.5; refract_ior=1.5; metalness=0; option_use_roughness=1; reflect_glossiness=Clara_Bermuda_4x4_Roughness; bump_map=Clara_Bermuda_4x4_Normal; bump_type=1; bump_amount=1; }
MtlSingleBRDF Clara_Bermuda_4x4 { brdf=Clara_Bermuda_4x4_brdf; }
