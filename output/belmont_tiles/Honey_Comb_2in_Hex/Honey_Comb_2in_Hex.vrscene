SettingsUnitsInfo Honey_Comb_2in_Hex_units { meters_scale=0.01; }
UVWGenChannel Honey_Comb_2in_Hex_uvw { uvw_channel=1; }
BitmapBuffer Honey_Comb_2in_Hex_Color_buffer { file="textures/Color.png"; transfer_function=2; gamma=1; }
TexBitmap Honey_Comb_2in_Hex_Color { bitmap=Honey_Comb_2in_Hex_Color_buffer; uvwgen=Honey_Comb_2in_Hex_uvw; tile=1; }
BitmapBuffer Honey_Comb_2in_Hex_Normal_buffer { file="textures/Normal.png"; transfer_function=0; gamma=1; }
TexBitmap Honey_Comb_2in_Hex_Normal { bitmap=Honey_Comb_2in_Hex_Normal_buffer; uvwgen=Honey_Comb_2in_Hex_uvw; tile=1; }
BitmapBuffer Honey_Comb_2in_Hex_Roughness_buffer { file="textures/Roughness.png"; transfer_function=0; gamma=1; }
TexBitmap Honey_Comb_2in_Hex_Roughness { bitmap=Honey_Comb_2in_Hex_Roughness_buffer; uvwgen=Honey_Comb_2in_Hex_uvw; tile=1; }
BRDFVRayMtl Honey_Comb_2in_Hex_brdf { diffuse=Honey_Comb_2in_Hex_Color; reflect=Color(1,1,1); fresnel=1; fresnel_ior=1.5; refract_ior=1.5; metalness=0; option_use_roughness=1; reflect_glossiness=Honey_Comb_2in_Hex_Roughness; bump_map=Honey_Comb_2in_Hex_Normal; bump_type=1; bump_amount=1; }
MtlSingleBRDF Honey_Comb_2in_Hex { brdf=Honey_Comb_2in_Hex_brdf; }
